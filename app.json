{
  "expo": {
    "name": "Royal Butterfly",
    "slug": "luxury-jewellery",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "luxuryjewellery",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FAF7F2",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FAF7F2"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.luxuryjewellery.app"
    },
    "android": {
      "package": "com.luxuryjewellery.app",
      "edgeToEdgeEnabled": true,
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "backgroundColor": "#FAF7F2",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-image",
      "expo-web-browser",
      "expo-sharing",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Royal Butterfly uses your location to auto-fill your delivery pincode and check availability in your area."
        }
      ]
    ],
    "extra": {
      "apiUrl": "https://api.royalbutterfly.in/api",
      "googleWebClientId": "1070822068903-146fllmcamqlqt1dg0d6oo9lfk4p33lm.apps.googleusercontent.com",
      "companyName": "Royal Butterfly",
      "companyLegalName": "Royal Butterfly",
      "companyEmail": "care@royalbutterfly.in",
      "companyPhone": "9594555962",
      "companyPhoneDisplay": "+91 9594555962",
      "companyAddress": "Office No 2, Matadin, Valai Pada, Nalasopara East, Palghar, Maharashtra 401209",
      "eas": {
        "projectId": "3b976646-396a-475e-967a-d32dcc4c2342"
      }
    },
    "owner": "prajwal31"
  }
}
